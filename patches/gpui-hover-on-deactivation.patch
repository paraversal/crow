+    fn window_deactivation_clears_the_hover_hit_test(cx: &mut TestAppContext) {
+        struct Root;
+
+        impl Render for Root {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                div().size(px(100.)).id("target").hover(|s| s)
