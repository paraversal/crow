+    #[gpui::test]
+    fn mouse_exit_clears_the_hover_hit_test(cx: &mut TestAppContext) {
+        struct Root;
+
+        impl Render for Root {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                div().size(px(100.)).id("target").hover(|s| s)
+            }
+        }
+
+        let window = cx.add_window(|_, _| Root);
+        let any_window = AnyWindowHandle::from(window);
+        cx.update_window(any_window, |_, window, cx| {
+            window.draw(cx).clear(cx);
+            window.simulate_mouse_move(point(px(10.), px(10.)), cx);
+            assert!(
+                !window.mouse_hit_test.ids.is_empty(),
+                "the target is under the pointer"
+            );
+            window.dispatch_event(
+                MouseExitEvent {
+                    position: point(px(10.), px(10.)),
+                    ..Default::default()
+                }
+                .to_platform_input(),
+                cx,
+            );
+            assert!(
+                window.mouse_hit_test.ids.is_empty(),
+                "the hover hit test is cleared"
+            );
+        })
+        .unwrap();
+    }
+
+    #[gpui::test]
+    fn window_deactivation_clears_the_hover_hit_test(cx: &mut TestAppContext) {
+        struct Root;
+
+        impl Render for Root {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                div().size(px(100.)).id("target").hover(|s| s)
+            }
+        }
+
+        let window = cx.add_window(|_, _| Root);
+        let any_window = AnyWindowHandle::from(window);
+        cx.update_window(any_window, |_, window, _| window.activate_window()).unwrap();
+        cx.run_until_parked();
+        cx.update_window(any_window, |_, window, cx| {
+            window.draw(cx).clear(cx);
+            window.simulate_mouse_move(point(px(10.), px(10.)), cx);
+            assert!(
+                !window.mouse_hit_test.ids.is_empty(),
+                "the target is under the pointer"
+            );
+        })
+        .unwrap();
+        VisualTestContext::from_window(any_window, cx).deactivate_window();
+        cx.run_until_parked();
+        cx.update_window(any_window, |_, window, _| {
+            assert!(
+                window.mouse_hit_test.ids.is_empty(),
+                "deactivation clears the hover hit test"
+            );
+        })
+        .unwrap();
+    }
