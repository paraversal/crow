+/// The modifier keys and source operations for one AppKit drag update.
+fn drag_modifiers_and_operations(
+    dragging_info: *mut AnyObject,
+) -> (Modifiers, ExternalDragOperations) {
+    let native_modifiers: NSEventModifierFlags =
+        unsafe { msg_send![class!(NSEvent), modifierFlags] };
+    let modifiers = Modifiers {
+        control: native_modifiers.contains(NSEventModifierFlags::Control),
+        alt: native_modifiers.contains(NSEventModifierFlags::Option),
+        shift: native_modifiers.contains(NSEventModifierFlags::Shift),
+        platform: native_modifiers.contains(NSEventModifierFlags::Command),
+        function: native_modifiers.contains(NSEventModifierFlags::Function),
+    };
+    let mask: NSDragOperation = unsafe { msg_send![dragging_info, draggingSourceOperationMask] };
+    let operations = ExternalDragOperations {
+        copy: mask.contains(NSDragOperation::Copy) || mask.contains(NSDragOperation::Generic),
+        move_: mask.contains(NSDragOperation::Move),
+    };
+    (modifiers, operations)
+}
+
+/// The operation AppKit should show for this update. Option always asks for a
+/// copy; otherwise the source's move wins when it is offered.
+fn accepted_drag_operation(
+    modifiers: Modifiers,
+    operations: ExternalDragOperations,
+) -> NSDragOperation {
+    if modifiers.alt || !operations.contains(DragOperation::Move) {
+        if operations.copy {
+            NSDragOperation::Copy
+        } else {
+            NSDragOperation::None
+        }
+    } else {
+        NSDragOperation::Move
+    }
 }
 
