+/// The operations a native drag source allows at the current pointer.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct ExternalDragOperations {
+    /// The source accepts a copy.
+    pub copy: bool,
+    /// The source accepts a move.
+    pub move_: bool,
+}
+
+impl Default for ExternalDragOperations {
+    fn default() -> Self {
+        Self { copy: true, move_: true }
+    }
+}
+
+impl ExternalDragOperations {
+    /// Whether the source allows `operation`.
+    pub fn contains(self, operation: DragOperation) -> bool {
+        match operation {
+            DragOperation::Copy => self.copy,
+            DragOperation::Move => self.move_,
+        }
+    }
+}
+
+/// One resource operation a native drag can perform.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
